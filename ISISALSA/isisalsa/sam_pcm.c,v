			return err;
		}
		//snd_pcm_set_ops(pcm, SNDRV_PCM_STREAM_CAPTURE, &snd_sam9407_capture_ops_56);
		pcm->private_data = sam;
		pcm->info_flags = 0;
		strcpy(pcm->name, "SAM9407 PCM 5/6");
