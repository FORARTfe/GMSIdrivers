	if (sam->voice_cnt >= SAM_MAX_PCM_CHANNELS)
		return -1;
	for (idx = SAM_MAX_PCM_CHANNELS-1; idx >= 0; idx--) {
		if (!(sam->voice_map & (1 << idx))) {
			sam->voice_map |= 1 << idx;
			sam->voice_cnt++;
			return idx;
		}
	}
	return -1;
