static void snd_sam9407_channel_free(sam9407_t *sam, int voice)
{
	if (sam->voice_map & (1 << voice)) {
		sam->voice_map &= ~(1 << voice);
		sam->voice_cnt--;
	}
}

sam9407_voice_t *snd_sam9407_voice_alloc(sam9407_t * sam)
{
	sam9407_voice_t *voice;
	int idx;

	idx = snd_sam9407_channel_alloc(sam);
	if(idx < 0)
		return NULL;

	voice = &sam->voices[idx];
	voice->number=idx;
	clear_bit(SAM_VOICE_PLAYING, &voice->status);
	set_bit(SAM_VOICE_IN_USE, &voice->status);
	voice->pcm = 1;
	voice->hwptr = 0;
	snd_printk("Allocated voice: %d %p\n", voice->number, voice);

	return voice;
}

void snd_sam9407_voice_free(sam9407_t * sam, sam9407_voice_t *voice)
{
	if (voice == NULL)
		return;

	voice->pcm = 0;
	clear_bit(SAM_VOICE_IN_USE, &voice->status);
	snd_sam9407_channel_free(sam, voice->number);
	snd_printk("Freed voice: %d %p\n", voice->number, voice);
}

