@#include <stdio.h>
#include <stdarg.h>
#include <stdio.h>
#include <stdlib.h>
#include <linux/ioctl.h>
#include <unistd.h>
       #include <sys/types.h>
       #include <sys/stat.h>
       #include <fcntl.h>

int main(int argc, char *argv[]) {
 int fd=0;
 int count;
 int offset=0;
 int i=0;
 int j=0;


 unsigned short *buff;

 if (argc<4) {
 	printf("Error in arguments\n");
 	printf("usage: genarray input count offset\n");
	return -1;
 }

 sscanf(argv[2],"%d",&count);

 sscanf(argv[3],"%d",&offset);

 if((fd=open(argv[1],O_RDONLY)) < 0) {
 	perror("Error opening file: ");
    free(buff);
	return -1;
 }

 lseek(fd,offset,SEEK_SET);

 buff=calloc(count, sizeof(unsigned short));

 if((read(fd,buff,count*sizeof(unsigned short)/sizeof(char))) < 0) {
 	perror("Error reading file: ");
    free(buff);
	return -1;
 }

 printf("#define TEST_SIZE %d\n",count);
 printf("#define TEST_OFFSET %d\n",offset);
  printf("u16 values[]={\n");

 for(i=0;i<count-8;i+=8) {
 	for(j=0;j<8;j++) {
		printf("0x%04X,", buff[i+j]);
	}
	printf("\n");
 }
 for(;i<count-1;i++) {
	printf("0x%04X,", buff[i]);
 }
 printf("0x%04X\n};\n", buff[count-1]);

 free(buff);

 close(fd);
 return 0;
}
