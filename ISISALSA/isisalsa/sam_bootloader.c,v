@#include <sam9407.h>
#include <sound/asound.h>
#include <getopt.h>
#include <stdarg.h>
#include <stdio.h>
#include <stdlib.h>
#include <alsa/asoundlib.h>
#include <linux/ioctl.h>

sam9407_ucode_t ucode;

int card = 0;

static void error(const char *fmt,...)
{
        va_list va;

        va_start(va, fmt);
        printf( "Error: ");
        printf(fmt, va);
        printf("\n");
        va_end(va);
}


static int sam9407_command (int idx, int dev, int command, char *filename)
{
	int fd, count, csum, err;
	snd_hwdep_t *handle;
	char name[16];

	sprintf(name, "hw:%i,%i", idx, dev);
	printf("\nhw:%i,%i\n", idx, dev);

	/* open SAM9407 hwdep device */
	if ((err = snd_hwdep_open(&handle, name, O_WRONLY)) < 0) {
		error("SAM9407 open (%i-%i): %s", idx, dev, snd_strerror(err));
        close(fd);
		return -1;
	}

	if ((fd = open(filename, O_RDONLY, 0)) == -1) {
		perror(filename);
        close(fd);
		return -1;
	}
	
	unsigned int FIRMWARE_MULTIMEDIA_SIZE = 55982;

    if((FIRMWARE_MULTIMEDIA_SIZE=lseek(fd,0x0,SEEK_END)) <= 0x400) {
       printf("  error determining length of the firmware file\n");
       close(fd);
       return -1;
    };
    if(lseek(fd,0x400,SEEK_SET) != 0x400) {
       printf("  error setting offset in the firmware file\n");
       close(fd);
       return -1;
    };

    if(SAM_MAX_UCODE_LEN < (FIRMWARE_MULTIMEDIA_SIZE-0x400)) {
       printf("  firmware too large\n");
       close(fd);
       return -1;
    }

 	/* read microcode to buffer */
	if ((count = read(fd, &ucode.prog, (FIRMWARE_MULTIMEDIA_SIZE-0x400))) < 0) {
		error("%s: read error %s", filename, strerror(errno));
        close(fd);
        return -1;
	}

    if(count != (FIRMWARE_MULTIMEDIA_SIZE-0x400)) {
       printf("  error reading the firmware file\n");
       close(fd);
       return -1;
    }

 	close(fd);

	/* load microcode to SAM9407 */
	strncpy (ucode.name, filename, 31);
	ucode.len = count >> 1; /* in 16bit words */

	/* calculate checksum */
	/*csum = 0;
	for (count = 0; count < ucode.len; count++) {
		csum += ucode.prog[count];
	}
	ucode.csum = csum;
	*/

    printf("  starting upload of firmware (size: %d)\n",ucode.len);

    //isis_burstwrite_data16(chip,firmware, (FIRMWARE_MULTIMEDIA_SIZE-0x400)/2);

	if ((err = snd_hwdep_ioctl(handle, SNDRV_SAM9407_IOCTL_FW_LOAD, &ucode)) < 0) {
		error("unable to load microcode: %d", err);
       close(fd);
       return -1;
	}
	printf("  firmware written\n");

	snd_hwdep_close(handle);
	return 0;
}

int main(int argc, char *argv[])
{
	int dev;
	int command, c;
	int err;

	char card_id[32]; 
	char *filename;

	snd_ctl_t *ctl_handle;
	snd_ctl_card_info_t *card_info;
	snd_hwdep_info_t *hwdep_info;

	snd_ctl_card_info_alloca(&card_info);
	snd_hwdep_info_alloca(&hwdep_info);

	filename = argv[argc-1];

	printf("uploading file %s\n",filename);

	while ((c = getopt(argc, argv, "c:")) != EOF) {
		switch (c) {
		case 'c':
			{
				card = snd_card_get_index(optarg);
				if (card < 0 || card > 31) {
					error ("wrong -c argument '%s'\n", optarg);
					return 1;
				}
			}
			break;
		default:
			return 1;
		}
	}
	printf(" to card %d\n",card);

	// Get control handle for selected card
	sprintf(card_id, "hw:%i", card);
	if ((err = snd_ctl_open(&ctl_handle, card_id, 0)) < 0) {
		error("control open (%s): %s", card_id, snd_strerror(err));
		return 1;
	}
	printf(" opened control\n");

	printf(" read hardware info\n");
	// Read control hardware info from card
	if ((err = snd_ctl_card_info(ctl_handle, card_info)) < 0) {
		error("control hardware info (%s): %s", card_id, snd_strerror(err));
		exit(1);
	}

	printf(" find HWDEP device\n");
	// find SAM9407 hardware dependant device and execute command
	dev = -1;
	err = 1;
	while (1) {
		printf(".");

		if ((err = snd_ctl_hwdep_next_device(ctl_handle, &dev)) < 0)
			error("hwdep next device (%s): %s", card_id, snd_strerror(err));
		if (dev < 0) {
			printf(" not found\n");
			break;
		}
		snd_hwdep_info_set_device(hwdep_info, dev);
		if ((err = snd_ctl_hwdep_info(ctl_handle, hwdep_info)) < 0) {
			printf("  ?\n");
			if (err != -ENOENT)
				error("control hwdep info (%s): %s", card_id, snd_strerror(err));
			continue;
		}
		if (snd_hwdep_info_get_iface(hwdep_info) == SNDRV_HWDEP_IFACE_SAM9407) {
			printf("  found\n");

			err = sam9407_command (card, dev, command, filename);
			break;
		}
	}
	if (err)
		error("no SAM9407 device present");
	printf("\n");

	snd_ctl_close(ctl_handle);
	return 0;
}
