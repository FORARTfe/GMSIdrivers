TOPDIR = ../..

include $(TOPDIR)/toplevel.config
include $(TOPDIR)/Makefile.conf

TOPDIR = $(MAINSRCDIR)

#
#
#

O_TARGET     := _sam9407.o

list-multi   := snd-sam9407-lib.o snd-isis.o

export-objs  := sam9407_lib.o

snd-sam9407-lib-objs := sam9407_lib.o sam_io.o sam_mem.o \
			sam_ctl.o sam_proc.o sam_ucode.o
snd-isis-objs := isis.o

# Toplevel Module Dependency
obj-$(CONFIG_SND_ISIS) += snd-isis.o snd-sam9407-lib.o

include $(TOPDIR)/Rules.make
all: snd-isis.o

modules: snd-isis.o snd-sam9407-lib.o

snd-sam9407-lib.o: $(snd-sam9407-lib-objs)
	$(LD) $(LD_RFLAG) -r -o $@@ $(snd-sam9407-lib-objs)

snd-isis.o: $(snd-isis-objs)
	$(LD) $(LD_RFLAG) -r -o $@@ $(snd-isis-objs)
@


