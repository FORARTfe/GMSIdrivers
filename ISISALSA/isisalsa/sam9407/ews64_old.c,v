struct snd_card_ews64 {
	struct resource *res_cport;
#ifdef __ISAPNP__
	struct isapnp_dev *sam9407;
	struct isapnp_dev *ctrl;
#endif
	int hw_version;		/* EWS card hardware version */
	snd_i2c_device_t *pcf8574_0, *pcf8574_1, *pcf8574_2,
			 *pcf8574_5, *pcf8574_7;
};

static snd_card_t *snd_ews64_cards[SNDRV_CARDS] = SNDRV_DEFAULT_PTR;

/* prototypes */
static int snd_ews64_setup(sam9407_t * chip, u32 * mem_size,
			   u16 * mmt_size);

#ifdef __ISAPNP__

static struct isapnp_card *snd_ews64_isapnp_cards[SNDRV_CARDS] __devinitdata = SNDRV_DEFAULT_PTR;
static const struct isapnp_card_id *snd_ews64_isapnp_id[SNDRV_CARDS] __devinitdata = SNDRV_DEFAULT_PTR;

#define ISAPNP_EWS64(_va, _vb, _vc, _device, _sam9407, _dctrl) \
	{ \
		ISAPNP_CARD_ID(_va, _vb, _vc, _device), \
		devs : { ISAPNP_DEVICE_ID(_va, _vb, _vc, _sam9407), \
			 ISAPNP_DEVICE_ID(_va, _vb, _vc, _dctrl), } \
        }

static struct isapnp_card_id snd_card_pnpids[] __devinitdata = {
	/* TerraTec AudioSystem EWS64 */
	ISAPNP_EWS64('C','S','C',0xa836,0x9407,0xa805),
	/* --- */
	{ ISAPNP_CARD_END, }	/* end */
};

ISAPNP_CARD_TABLE(snd_card_pnpids);

#endif /* __ISAPNP__ */

#define EWS64_VER_MASK	0x0f
#define EWS64_VER_10	0x01
#define EWS64_VER_11	0x02
#define EWS64_VER_12	0x03

#define EWS64_EXT_MASK	0xf0
#define EWS64_EXT_XL	0x80	/* XL front panel digital extension */
#define EWS64_EXT_R	0xa0	/*  R front panel digital extension */

/*
 * access via i2c mode
 */
#define EWS64_I2C_CLOCK		0x02	/* i2c clock line */
#define EWS64_MAIN_I2C_DATA	0x04	/* i2c data line on main bus */
#define EWS64_AUX_I2C_DATA	0x08	/* i2c data line on aux bus */

#define EWS64_MAIN_I2C_MASK	~(EWS64_MAIN_I2C_DATA | EWS64_I2C_CLOCK)
#define EWS64_AUX_I2C_MASK	~(EWS64_AUX_I2C_DATA | EWS64_I2C_CLOCK)

/* pcf8574 addresses */
#define EWS64_PCF8574_0		(0x40>>1)	/* L/XL control */
#define EWS64_PCF8574_1		(0x42>>1)	/* L/XL rev 1.2 control */
#define EWS64_PCF8574_2		(0x44>>1)	/* L/XL rev 1.0 control */
#define EWS64_PCF8574_5		(0x4a>>1)	/* R front panel control */
#define EWS64_PCF8574_7		(0x4e>>1)	/* XL/R front panel control */

/* pcf8574 addr 0 */
#define EWS64_NO_MIDI2_JOYPORT		0x01	/* MIDI2 NOT routed to joystick port (high impedance) */
#define EWS64_NO_MIDI1_JOYPORT		0x02	/* MIDI1 NOT routed to joystick port (high impedance) */
#define EWS64_ONBOARD_CLOCK_MASK	0x0c
#define   EWS64_12_MASTER_CLOCK_EXT	0x00	/* [rev 1.2] disconnect onboard master-clock and use external */
#define   EWS64_MASTER_CLOCK_48K	0x04	/* set onboard master-clock oscillator to 12.2880MHz */
#define   EWS64_MASTER_CLOCK_44K1	0x08	/* set onboard master-clock oscillator to 11.2896MHz */
#define   EWS64_MASTER_CLOCK_32K	0x0c	/* set onboard master-clock oscillator to 8.0000Mhz */
#define EWS64_SAM9407_INPUT_MASK	0x10
#define   EWS64_DIG_IN_TO_SAM9407	0x00	/* Digital IN data to 9407 I2S input (from dig. ext. R or F) */
#define   EWS64_ADC_TO_SAM9407		0x10	/* ADC output to 9407 I2S input (Line In2 or codec out) */
#define EWS64_10_SIMM_DECODING_MASK	0x20	/* [rev 1.0] */
#define   EWS64_10_SET_SIMM_DECODING_0	0x00	/* [rev 1.0] Set SIMM decoding to 16MB ss, 64MB ss */
#define   EWS64_10_SET_SIMM_DECODING_1	0x20	/* [rev 1.0] Set SIMM decoding to No Simm, 4MB ss, 8MB ss */
#define EWS64_SAM9407_HARD_RESET	0x80	/* 9407 in hard reset state */

/* pcf8574 addr 1 */
#define EWS64_12_SIMM_DECODING_MASK	0x02	/* [rev 1.2] */
#define   EWS64_12_SET_SIMM_DECODING_0	0x00	/* [rev 1.2] Set SIMM decoding to No Simm, 4MB ss, 8MB ds */
#define   EWS64_12_SET_SIMM_DECODING_1	0x01	/* [rev 1.2] Set SIMM decoding to 8MB ss */
#define   EWS64_12_SET_SIMM_DECODING_2	0x02	/* [rev 1.2] Set SIMM decoding to 16MB ss, 32MB ds */
#define   EWS64_12_SET_SIMM_DECODING_3	0x03	/* [rev 1.2] Set SIMM decoding to 64MB ss */
#define EWS64_12_I2S_WORD_SHIFTER_OFF	0x04	/* [rev 1.2] I2S word shifter OFF, -6dB firmware NOT active */
#define EWS64_12_I2S_CLIP_DETECTION_ON	0x08	/* [rev 1.2] I2S clip detection trigger active */
#define EWS64_12_ADC_CLIPPING		0x10	/* [rev 1.2] [input] ADC clipping detected */
#define EWS64_12_I2S_CLIPPING		0x20	/* [rev 1.2] [input] I2S clipping detected */

/* pcf8574 addr 2 */
#define EWS64_10_I2S_WORD_SHIFTER_OFF	0x04	/* [rev 1.0] I2S word shifter OFF, -6dB firmware NOT active */
#define EWS64_10_I2S_CLIP_DETECTION_ON	0x08	/* [rev 1.0] I2S clip detection trigger active */
#define EWS64_10_I2S_CLIPPING		0x20	/* [rev 1.0] [input] I2S clipping detected */
#define EWS64_10_MASTER_CLOCK_INT	0x80	/* [rev 1.0] use onboard master-clock oscillator */

/* pcf8574 addr 5 */
/* TODO: R digital extension */

/* pcf8574 addr 7 */
#define EWS64_SET_COPY_INHIBIT		0x02	/* [XL] set copy inhibit flag */
#define EWS64_SET_ORIGINAL		0x04	/* [XL] set original flag */
#define EWS64_XL_INPUT_MASK		0x80
#define   EWS64_XL_INPUT_OPTICAL	0x00	/* [XL] optical digital input selected */
#define   EWS64_XL_INPUT_COAX		0x80	/* [XL] coax digital input selected */

/* get shared SCL line */
static int snd_ews64_i2c_getclockline(snd_i2c_bus_t *bus)
{
	unsigned long port = bus->private_value;
	unsigned char res;

	res = !!(inb(port) & EWS64_I2C_CLOCK);
	return res;
}

/* set SDA and SCL on main I2C bus */
static void snd_ews64_main_i2c_setlines(snd_i2c_bus_t *bus, int clk, int data)
{
	unsigned long port = bus->private_value;
	unsigned char tmp = EWS64_MAIN_I2C_MASK;

	if (clk)
		tmp |= EWS64_I2C_CLOCK;
	if (data)
		tmp |= EWS64_MAIN_I2C_DATA;

	outb(tmp, port);
	udelay(5);
}

/* get SDA from main I2C bus */
static int snd_ews64_main_i2c_getdataline(snd_i2c_bus_t *bus, int ack)
{
	unsigned long port = bus->private_value;
	int data;

	if (ack)
		udelay(5);
	data = !!(inb(port) & EWS64_MAIN_I2C_DATA);
	return data;
}

static snd_i2c_bit_ops_t snd_ews64_main_i2c_bit_ops = {
	setlines: snd_ews64_main_i2c_setlines,
	getclock: snd_ews64_i2c_getclockline,
	getdata:  snd_ews64_main_i2c_getdataline,
};

/* set SDA and SCL on aux I2C bus */
static void snd_ews64_aux_i2c_setlines(snd_i2c_bus_t *bus, int clk, int data)
{
	unsigned long port = bus->private_value;
	unsigned char tmp = EWS64_AUX_I2C_MASK;

	if (clk)
		tmp |= EWS64_I2C_CLOCK;
	if (data)
		tmp |= EWS64_AUX_I2C_DATA;

	outb(tmp, port);
	udelay(5);
}

/* get SDA from bus B */
static int snd_ews64_aux_i2c_getdataline(snd_i2c_bus_t *bus, int ack)

{
	unsigned long port = bus->private_value;
	int data;

	if (ack)
		udelay(5);
	data = !!(inb(port) & EWS64_AUX_I2C_DATA);
	return data;
}

static snd_i2c_bit_ops_t snd_ews64_aux_i2c_bit_ops = {
	setlines: snd_ews64_aux_i2c_setlines,
	getclock: snd_ews64_i2c_getclockline,
	getdata:  snd_ews64_aux_i2c_getdataline,
};

#ifdef __ISAPNP__

static int __init snd_card_ews64_isapnp(int dev, struct snd_card_ews64 *acard)
{
	const struct isapnp_card_id *id = snd_ews64_isapnp_id[dev];
	struct isapnp_card *card = snd_ews64_isapnp_cards[dev];
	struct isapnp_dev *pdev;
	
	acard->sam9407 = isapnp_find_dev(card, id->devs[0].vendor, id->devs[0].function, NULL);
	if (acard->sam9407->active) {
		return -EBUSY;
		}
	acard->ctrl = isapnp_find_dev(card, id->devs[1].vendor, id->devs[1].function, NULL);
	if (acard->ctrl->active) {
		acard->sam9407 = NULL;
		return -EBUSY;
		}

	/* sam9407 initialization */
	pdev = acard->sam9407;
	if (pdev->prepare(pdev) < 0)
		return -EAGAIN;
	if (snd_port[dev] != SNDRV_AUTO_PORT)
		isapnp_resource_change(&pdev->resource[0], snd_port[dev], 4);
	if (snd_irq[dev] != SNDRV_AUTO_IRQ)
		isapnp_resource_change(&pdev->irq_resource[0], snd_irq[dev], 1);
	if (pdev->activate(pdev)<0) {
		snd_port[dev] = SNDRV_AUTO_PORT;
		snd_irq[dev] = SNDRV_AUTO_IRQ;
		snd_printk(IDENT " isapnp configure failed for sam9407 (out of resources?)\n");
	} else {
		snd_port[dev] = pdev->resource[0].start;
		snd_irq[dev] = pdev->irq_resource[0].start;
	}
	snd_printdd("[isapnp] sam9407: port=0x%lx, irq=%i\n",
		     snd_port[dev], snd_irq[dev]);
	/* digital controller initialization */
	pdev = acard->ctrl;
	if (pdev->prepare(pdev) < 0) {
		acard->sam9407->deactivate(acard->sam9407);
		return -EAGAIN;
	}
	if (snd_cport[dev] != SNDRV_AUTO_PORT)
		isapnp_resource_change(&pdev->resource[0], snd_cport[dev], 1);
	if (pdev->activate(pdev)<0) {
		snd_printk(IDENT " isapnp configure failed for digital CTRL (out of resources?)\n");
		snd_cport[dev] = SNDRV_AUTO_PORT;
	} else {
		snd_cport[dev] = pdev->resource[0].start;
	}
	snd_printdd("[isapnp] digital CTRL: control port=0x%lx\n", snd_cport[dev]);
	return 0;
}

static void snd_card_ews64_deactivate(struct snd_card_ews64 *acard)
{
	if (acard->sam9407) {
		acard->sam9407->deactivate(acard->sam9407);
		acard->sam9407 = NULL;
	}
	if (acard->ctrl) {
		acard->ctrl->deactivate(acard->ctrl);
		acard->ctrl = NULL;
	}
}
#endif

static void snd_card_ews64_free(snd_card_t *card)
{
	struct snd_card_ews64 *acard = (struct snd_card_ews64 *)card->private_data;

	if (acard) {
#ifdef __ISAPNP__
		snd_card_ews64_deactivate(acard);
#endif
		if (acard->res_cport)
			release_resource(acard->res_cport);
	}
}

static int __init snd_card_ews64_probe(int dev)
{
	sam9407_t *chip;
	snd_card_t *card;
	struct snd_card_ews64 *acard;
	snd_i2c_bus_t *main_i2c_bus, *aux_i2c_bus;

	char name[32];
	char *str;

	int i, err;

#ifdef __ISAPNP__
	if (!snd_isapnp[dev]) {
#endif
		if (snd_port[dev] < 0)
			snd_port[dev] = SNDRV_AUTO_PORT;
		if (snd_port[dev] == SNDRV_AUTO_PORT) {
			snd_printk("specify snd_port\n");
			return -EINVAL;
		}
		if (snd_cport[dev] < 0)
			snd_cport[dev] = SNDRV_AUTO_PORT;
		if (snd_cport[dev] == SNDRV_AUTO_PORT) {
			snd_printk("specify snd_cport\n");
			return -EINVAL;
		}
#ifdef __ISAPNP__
	}
#endif
	card = snd_card_new(snd_index[dev], snd_id[dev], THIS_MODULE,
			    sizeof(struct snd_card_ews64));
	if (card == NULL)
		return -ENOMEM;
	acard = (struct snd_card_ews64 *)card->private_data;
	card->private_free = snd_card_ews64_free;
#ifdef __ISAPNP__
	if (snd_isapnp[dev] && (err = snd_card_ews64_isapnp(dev, acard))<0) {
		snd_printk("isapnp detection failed and probing for " IDENT " is not supported\n");
		snd_card_free(card);
		return -ENXIO;
	}
#endif

	/* digital CTRL (I2C) initilization */

	if ((acard->res_cport = request_region(snd_cport[dev], 1, IDENT " digital CTRL (I2C bus)")) == NULL) {
		snd_printk("unable to register " IDENT " digital CTRL port at 0x%lx\n", snd_cport[dev]);
		snd_card_free(card);
		return -ENODEV;
	}

	sprintf(name, IDENT "-%i(A)", card->number);
	if ((err = snd_i2c_bus_create(card, name, NULL, &main_i2c_bus)) < 0) {
		snd_card_free(card);
		return err;
	}
	main_i2c_bus->private_value = snd_cport[dev];
	main_i2c_bus->hw_ops.bit = &snd_ews64_main_i2c_bit_ops;

	sprintf(name, IDENT "-%i(B)", card->number);
	if ((err = snd_i2c_bus_create(card, name, main_i2c_bus, &aux_i2c_bus)) < 0) {
		snd_card_free(card);
		return err;
	}
	aux_i2c_bus->private_value = snd_cport[dev];
	aux_i2c_bus->hw_ops.bit = &snd_ews64_aux_i2c_bit_ops;

	/* tea6320 detection and initalization */
	if ((err = snd_tea6320_detect(main_i2c_bus)) < 0) {
		snd_printk ("unable to detect tea6320 #1 - main i2c bus trouble?\n");
		goto __tea_error;
	}
	if ((err = snd_tea6320_create(card, main_i2c_bus, 1, 0)) < 0) {
		snd_printk ("unable to initialize tea6320 #1\n");
		goto __tea_error;
	}

	if ((err = snd_tea6320_detect(aux_i2c_bus)) < 0) {
		snd_printk ("unable to detect tea6320 #2 - aux_i2c bus trouble?\n");
		goto __tea_error;
	}
	if ((err = snd_tea6320_create(card, aux_i2c_bus, 2, 0)) < 0) {
		snd_printk ("unable to initialize tea6320 #2\n");
		goto __tea_error;
	}

 __tea_error:
	if (err < 0) {
		snd_card_free(card);
		return err;
	}

	/* pcf8574 detection - compose EWS64 version from active addresses */
	acard->hw_version = 0x00;
	snd_i2c_lock(main_i2c_bus);
		for (i = 0; i < 8; i++)
			if (snd_i2c_probeaddr(main_i2c_bus, EWS64_PCF8574_0 | i) > 0)
				acard->hw_version |= (1 << i);
	snd_i2c_unlock(main_i2c_bus);
	snd_printdd("EWS64 type 0x%x detected\n", acard->hw_version);

	/* FIXME: This will be removed ... or not */
	if (acard->hw_version != (EWS64_EXT_XL | EWS64_VER_12)) {
		snd_printk ("Sorry... Only EWS64XL version 1.2 is currently supported\n");
		snd_card_free(card);
		return -ENODEV;
	}

	/* create pcf8574 devices */
	if ((err = snd_i2c_device_create(main_i2c_bus, "PCF8574-0",
					 EWS64_PCF8574_0, &acard->pcf8574_0)) < 0)
		goto __pcf_error;

	if ((acard->hw_version & EWS64_VER_MASK) == EWS64_VER_12) {
		if ((err = snd_i2c_device_create(main_i2c_bus, "PCF8574-1",
						 EWS64_PCF8574_1, &acard->pcf8574_1)) < 0)
			goto __pcf_error;
	}
	if ((acard->hw_version & EWS64_VER_MASK) == EWS64_VER_10) {
		if ((err = snd_i2c_device_create(main_i2c_bus, "PCF8574-2",
						 EWS64_PCF8574_2, &acard->pcf8574_2)) < 0)
			goto __pcf_error;
	}
	if ((acard->hw_version & EWS64_EXT_R) == EWS64_EXT_R) {
		if ((err = snd_i2c_device_create(main_i2c_bus, "PCF8574-5",
						 EWS64_PCF8574_5, &acard->pcf8574_5)) < 0)
			goto __pcf_error;
	}
	if (acard->hw_version & EWS64_EXT_XL) {
		if ((err = snd_i2c_device_create(main_i2c_bus, "PCF8574-7",
						 EWS64_PCF8574_7, &acard->pcf8574_7)) < 0)
			goto __pcf_error;
	}

 __pcf_error:
	if (err < 0) {
		snd_printk ("unable to create pcf8574 devices\n");
		snd_card_free(card);
		return err;
	}

	/* initialize pcf8574 devices */
	snd_i2c_lock(main_i2c_bus);
	acard->pcf8574_0->private_value = (EWS64_NO_MIDI2_JOYPORT |
					   EWS64_NO_MIDI1_JOYPORT |
					   EWS64_MASTER_CLOCK_44K1 |
					   EWS64_ADC_TO_SAM9407);
	if ((err = snd_i2c_sendbytes(acard->pcf8574_0, (char *) &acard->pcf8574_0->private_value, 1)) < 0)
		goto __i2c_error;
	if ((acard->hw_version & EWS64_VER_MASK) == EWS64_VER_12) {
		acard->pcf8574_1->private_value = (EWS64_12_SET_SIMM_DECODING_2 |
						   EWS64_12_I2S_WORD_SHIFTER_OFF |
						   EWS64_12_I2S_CLIP_DETECTION_ON);
		if ((err = snd_i2c_sendbytes(acard->pcf8574_1, (char *) &acard->pcf8574_1->private_value, 1)) < 0)
			goto __i2c_error;
	}
	if ((acard->hw_version & EWS64_VER_MASK) == EWS64_VER_10) {
		acard->pcf8574_2->private_value = (EWS64_10_I2S_WORD_SHIFTER_OFF |
						   EWS64_10_I2S_CLIP_DETECTION_ON |
						   EWS64_10_MASTER_CLOCK_INT);
		if ((err = snd_i2c_sendbytes(acard->pcf8574_2, (char *) &acard->pcf8574_2->private_value, 1)) < 0)
			goto __i2c_error;
	}
	if ((acard->hw_version & EWS64_EXT_R) == EWS64_EXT_R) {
		acard->pcf8574_5->private_value = 0x9b; /* FIXME */
		if ((err = snd_i2c_sendbytes(acard->pcf8574_5, (char *) &acard->pcf8574_5->private_value, 1)) < 0)
			goto __i2c_error;
	}
	if (acard->hw_version & EWS64_EXT_XL) {
		acard->pcf8574_7->private_value = (EWS64_SET_COPY_INHIBIT |
						   EWS64_SET_ORIGINAL);
		if ((err = snd_i2c_sendbytes(acard->pcf8574_7, (char *) &acard->pcf8574_7->private_value, 1)) < 0)
			goto __i2c_error;
	}

	/* ews64 specific sam9407 hardware reset (i2c bus is still locked) */
	acard->pcf8574_0->private_value |= EWS64_SAM9407_HARD_RESET;
	if ((err = snd_i2c_sendbytes(acard->pcf8574_0, (char *) &acard->pcf8574_0->private_value, 1)) < 0)
		goto __i2c_error;
	snd_i2c_unlock(main_i2c_bus);

	mdelay(1);	/* huh? */

	snd_i2c_lock(main_i2c_bus);
	acard->pcf8574_0->private_value &= ~EWS64_SAM9407_HARD_RESET;
	err = snd_i2c_sendbytes(acard->pcf8574_0, (char *) &acard->pcf8574_0->private_value, 1);
	
 __i2c_error:
	snd_i2c_unlock(main_i2c_bus);
	if (err < 0) {
		snd_printk ("unable to initialize pcf8574 devices\n");
		snd_card_free(card);
		return err;
	}

	mdelay(1);	/* give sam9407 some time to recover */

	if ((err = snd_sam9407_create(card,
				      snd_port[dev],
				      snd_irq[dev],
				      snd_ews64_setup,
				      &chip)) < 0) {
		snd_card_free(card);
		return err;
	}

	switch (acard->hw_version & EWS64_EXT_MASK) {
	case EWS64_EXT_XL:
		str = "XL";
		break;
	case EWS64_EXT_R:
		str = "XXL";
		break;
	default:
		str = "L";
	}

	switch (acard->hw_version & EWS64_VER_MASK) {
	case EWS64_VER_11:
		i = 1;
		break;
	case EWS64_VER_12:
		i = 2;
		break;
	default:
		i = 0;
	}

	strcpy(card->driver, IDENT);
	sprintf(card->shortname, IDENT "%s [v1.%i]", str, i);
	sprintf(card->longname, "%s at 0x%lx, irq %i",
		card->shortname,
		snd_port[dev],
		snd_irq[dev]);
	if ((err = snd_card_register(card)) < 0) {
		snd_card_free(card);
		return err;
	}
	snd_ews64_cards[dev] = card;
	return 0;
}


/* Memory probing routine. Works only with L/XL ver 1.2
 * Based on code donated by TerraTec.
 */
static u32 snd_ews64_get_mem(sam9407_t * chip)
{
	sam9407_mmt_entry_t mmt[256];
	u32 probe_addr = 0x200;	/* words */
	u32 tmp_addr;

	u16 tmp1, tmp2;
	u16 id;

	int slot = 0;
	int loops, err;

	mmt[slot].id = SAM_MMT_ID_MEMSIZE;

	while (probe_addr < (64 << 19)) {
		loops = 5;
	__again:
		if ((err = snd_sam9407_read(chip, &tmp1, probe_addr, 1)) < 0)
			goto __error;
		tmp2 = tmp1 ^ 0x55aa;
		if ((err = snd_sam9407_write(chip, &tmp2, probe_addr, 1)) < 0)
			goto __error;
		err = snd_sam9407_read(chip, &tmp2, probe_addr, 1);

	__error:
		if (err == -EBUSY) {
			udelay(100);
			if (--loops)
				goto __again;
			else
				/* something went wrong */
				return 0;
		}

		if ((tmp1 ^ 0x55aa) == tmp2)
			/* RAM */
			id = SAM_MMT_ID_FREE;
		else
			/* ROM */
			id = SAM_MMT_ROM_MASK | SAM_MMT_ID_RESERVED;

		if (id != mmt[slot].id) {
			slot++;
			mmt[slot].id = id;
			mmt[slot].addr[1] = probe_addr >> 16;
			mmt[slot].addr[0] = probe_addr;
		}

		/* all slots filled up */
		if (slot > 254)
			return 0;

		/* increase probe addr for 1MByte (512kwords) */
		probe_addr = ((probe_addr >> 19) + 1) << 19;

		/* max ROM block = 4Mwords ?? */ 
		if (mmt[slot].id != SAM_MMT_ID_FREE) {
			tmp_addr = (mmt[slot].addr[1] << 16) | mmt[slot].addr[0];
			if (probe_addr - tmp_addr > (4 << 20))
				break;
		}
	}

	if (mmt[slot].id == SAM_MMT_ID_FREE) {
		slot++;
		mmt[slot].id = 0xffff;
		mmt[0].addr[1] = mmt[slot].addr[1] = probe_addr << 16;
		mmt[0].addr[0] = mmt[slot].addr[0] = probe_addr;
	} else {
		mmt[slot].id = 0xffff;
		mmt[0].addr[1] = mmt[slot].addr[1];
		mmt[0].addr[0] = mmt[slot].addr[0];
	}
#if 0
	for (slot = 0; slot < 256; slot++) {
		printk("0x%x, 0x%x\n",
		       mmt[slot].id, (mmt[slot].addr[1] << 16) | mmt[slot].addr[0]);
		if ((mmt[slot].id & SAM_MMT_ID_MASK) == SAM_MMT_ID_EOM)
			break;
	}
#endif
	/* return Mwords */
	return ((mmt[0].addr[1] << 16) | mmt[0].addr[0]);
}

/* Check address wrap of SIMM card. Donated by TerraTec */
static int snd_ews64_check_addr(sam9407_t * chip, u32 addr1, u32 addr2)
{
	u16 data;
	int loops = 5;
	int err;

 __again:
	data = 0;
	if ((err = snd_sam9407_write(chip, &data, addr1, 1)) < 0)
		goto __error;
	data++;
	if ((err = snd_sam9407_write(chip, &data, addr2, 1)) < 0)
		goto __error;
	err = snd_sam9407_read(chip, &data, addr1, 1);

 __error:
	if (err == -EBUSY) {
		udelay(100);
		if (--loops)
			goto __again;
	}
	return (data);
}

/* set ews64 SIMM bits */
static int snd_ews64_set_simm_bits(snd_i2c_device_t * dev, u8 bits)
{
	int err;

	snd_i2c_lock(dev->bus);
	dev->private_value &= ~EWS64_12_SIMM_DECODING_MASK;
	dev->private_value |= bits;
	err = snd_i2c_sendbytes(dev, (char *) &dev->private_value, 1);
	snd_i2c_unlock(dev->bus);

	return err;
}


/* EWS setup function - portions donated by TerraTec */
static int snd_ews64_setup(sam9407_t * chip, u32 * mem_size,
			   u16 * mmt_size)
{
	snd_card_t *card = (snd_card_t *) chip->card;
	struct snd_card_ews64 *acard = (struct snd_card_ews64 *)card->private_data;

	u8 data;
	u8 bytes[6];

	u32 mem_detect;
	char *simm_msg;

	char VerStr[12];
	u32 VerStr_addr;

	int sample_rate;
	int sbk_size;

	int err;
	int i;

	/* get basic SAM info */
	err = snd_sam9407_command(chip->system_io_queue, 0x06, /* GET_SR */
				  &data, 1, bytes, 6, 0x02);
	if (err < 0) {
		snd_printd("ews64: can't get basic SAM info\n");
		goto __error;
	}
	sample_rate = (bytes[1] << 8) | bytes[0];
	sbk_size = (bytes[3] << 8) | bytes[2];

	*mmt_size = (bytes[5] << 8) | bytes[4];

	/* detect memory size */
	if ((acard->hw_version & EWS64_VER_MASK) != EWS64_VER_12) {
		snd_printd("ews64: memory probing not supported\n");
		err = -EIO;
		goto __error;
	}

	/* set decoding to 16MB SIMM, as suggested by TerraTec */
	snd_ews64_set_simm_bits(acard->pcf8574_1, EWS64_12_SET_SIMM_DECODING_2);

	mem_detect = snd_ews64_get_mem(chip);
	if (mem_detect == 0) {
		err = -ENOMEM;
		goto __error;
	}

	switch (mem_detect >> 19) {
	case 2:
		snd_ews64_set_simm_bits(acard->pcf8574_1, EWS64_12_SET_SIMM_DECODING_0);
		break;
	case 18:
		/* check 4/8S/(16/64MB) SIMM */
		if (snd_ews64_check_addr(chip, 2 << 19, 4 << 19)) {
			/* 4MB wrapped to 2MB -> 4MB SIMM */
// test
//			snd_ews64_set_simm_bits(acard->pcf8574_1, EWS64_12_SET_SIMM_DECODING_0);
			simm_msg = "4 MB";
		} else if (snd_ews64_check_addr(chip, 2 << 19, 6 << 19)) {
			/* 6MB wrapped to 2MB -> 8MB SS SIMM */
			snd_ews64_set_simm_bits(acard->pcf8574_1, EWS64_12_SET_SIMM_DECODING_1);
			simm_msg = "8 MB single-sided";
		} else {
			/* check 16/64MB SIMM */
			snd_ews64_set_simm_bits(acard->pcf8574_1, EWS64_12_SET_SIMM_DECODING_3);
			if (snd_ews64_check_addr(chip, 2 << 19, 10 << 19)) {
				/* 10MB wrapped to 2MB -> 16MB SIMM */
				snd_ews64_set_simm_bits(acard->pcf8574_1, EWS64_12_SET_SIMM_DECODING_2);
				simm_msg = "16 MB";
			} else {
				simm_msg = "64 MB";
			}
		}
		break;
	case 34:
		/* check 8D/32MB SIMM */
		if (snd_ews64_check_addr(chip, 18 << 19, 20 << 19)) {
			/* 20MB wrapped to 18MB -> 8MB DS SIMM */
			snd_ews64_set_simm_bits(acard->pcf8574_1, EWS64_12_SET_SIMM_DECODING_0);
			simm_msg = "8 MB double-sided";
		} else {
			simm_msg = "32 MB";
		}
		break;
	default:
		snd_printd("ews64: SIMM detection failed\n");
		err = -EIO;
		goto __error;
	}

	mem_detect = snd_ews64_get_mem(chip);
	if (mem_detect == 0) {
		err = -ENOMEM;
		goto __error;
	}






	
	// test!!
	printk("TEST!\n");
	return -EBUSY;



	snd_printd("ews64: %s SIMM detected\n", simm_msg);
	*mem_size = mem_detect;

	/* enable readback table change notification */
	data = 0x7f;
	err = snd_sam9407_command(chip->pcm_io_queue, 0x3e, /* EN_RDBINT */
				  &data, 1, NULL, 0, -1);

#if 0
	/* allocate control table extension */
	ctl_table_ext = (u16 *) vmalloc(sizeof(u16) * SAM_CTL_TABLE_EXT_SIZE);
	if (ctl_table_ext == NULL)
		return -ENOMEM;

	/* Control table extension follows control table */
	CTLTable_ext_addr = CTLTable_addr + SAM_CTL_TABLE_SIZE;

	/* read control table extension */
	err = snd_sam9407_read(chip, chip->ctl_table_ext, CTLTable_ext_addr, SAM_CTL_TABLE_EXT_SIZE);
	if (err < 0) {
