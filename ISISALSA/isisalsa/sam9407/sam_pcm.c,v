/* PCM playback controls */
#define SAM_W_PITCH		0x44	/* Change the pitch of the wave during playback */
#define SAM_W_VOLLEFT	0x45	/* Change the current left volume */
#define SAM_W_VOLRIGHT	0x46	/* Change the current right volume */
#define SAM_W_VOLAUXLEFT	0x47 	/* Change the left auxiliary level */
#define SAM_W_VOLAUXRIGHT	0x49	/* Change the right auxiliary level */
#define SAM_W_FILT_FC	0x4a	/* Change filter cutoff frequency */
#define SAM_W_FILT_Q	0x4b	/* Change filter resonance */

#define SAM_END_XFER	0x43	/* Sent to SAM9407 after end of transfer */

#define SAM_MAX_PCM_CHANNELS	32

#define SAM_PLAY_OVERHEAD	16	/* magic playback buffer overhead */

#define SAM_MAX_BUFFER_SIZE	(256 * 1024)


static int snd_sam9407_playback_hw_params(snd_pcm_substream_t * substream,
				  snd_pcm_hw_params_t * hw_params)
{
	sam9407_t *sam = snd_pcm_substream_chip(substream);
	snd_pcm_runtime_t *runtime = substream->runtime;
	snd_sam_voice_t *voice = (snd_sam_voice_t *) runtime->private_data;

	u16 id;
	size_t words;

	unsigned long flags;
	int err;

	printk("TEST (hw_params) voice %i\n", voice->num);

	if ((err = snd_pcm_lib_malloc_pages(substream, params_buffer_bytes(hw_params))) < 0)
		return err;

	id = SAM_MMT_ID_PCM & (voice->num << 8);

	words = runtime->dma_bytes >> 1;

	/* allocate 2x buffer + some magic overhead */
	words <<= 1;
	words += SAM_PLAY_OVERHEAD;

	spin_lock(sam->mmt_lock);

	/* paranoia: release sam9407 buffer */
	if (voice->buf_addr)
		snd_sam9407_mem_free(sam, id);

	err = snd_sam9407_mem_alloc(sam, id, &voice->buf_addr, words,
			        SAM_ALIGN_EVEN, SAM_BOUNDARY_64K);
	spin_unlock(sam->mmt_lock);
	if (err < 0)
		return err;
	}
	printk("TEST (hw_params leave) voice %i, allocated %i words in SAM memory\n",
	       voice->num, words);

	return 0;
}

static int snd_sam9407_playback_hw_free(snd_pcm_substream_t * substream)
{
	sam9407_t *sam = snd_pcm_substream_chip(substream);
	snd_pcm_runtime_t *runtime = substream->runtime;
	snd_sam_voice_t *voice = (snd_trident_voice_t *) runtime->private_data;

	printk("TEST (hw_free) voice %i\n", voice->num);

	id = SAM_MMT_ID_PCM & (voice->num << 8);

	/* wait here max 500ms for chip to finish playback */
	end_time = jiffies + (HZ / 2);
	do {
		if(test_bit(SAM_VOICE_PLAYING, &voice->status)) {
			set_current_state(TASK_UNINTERRUPTIBLE);
			schedule_timeout(1);
		} else {
			goto __released;
		}
	} while (end_time - (signed long) jiffies >= 0);
	snd_printk("sam9407: voice close ACK timeout\n");

 __released:

	/* release SAM PCM buffer */
	if (voice->buf_addr) {
		spin_lock(sam->mmt_lock);
		snd_sam9407_mem_free(sam, id);
		spin_unlock(sam->mmt_lock);
		voice->buf_addr = 0;
	}

	snd_pcm_lib_free_pages(substream);

	printk("TEST (hw_free leave) voice %i\n", voice->num);
	return 0;
}

static int snd_sam9407_playback_prepare(snd_pcm_substream_t * substream)
{
	sam9407_t *sam = snd_pcm_substream_chip(substream);
	snd_pcm_runtime_t *runtime = substream->runtime;
	snd_trident_voice_t *voice = (snd_trident_voice_t *) runtime->private_data;

	u8 format;
	u8 bytes[4];

	format = runtime->channels > 1 ? SAM_PCM_STEREO : SAM_PCM_MONO;
	format |= snd_pcm_format_width(runtime->format) > 8 ? SAM_PCM_16BIT : SAM_PCM_8BIT;

	bytes[0] = voice->num;
	bytes[1] = format;
	bytes[2] = (u8) runtime->rate;
	bytes[3] = (u8) (runtime->rate >> 8);

	/* send command, but ignore acknowledge */
	snd_sam9407_command(NULL, SAM_CMD_W_OPEN,
			bytes, 4, NULL, 0, -1);

	return 0;
}

static int snd_sam9407_trigger(snd_pcm_substream_t *substream,
			 int cmd)
				    
{
	sam9407_t *trident = snd_pcm_substream_chip(substream);
	snd_sam9407_voice_t *voice = (snd_sam9407_voice_t *) substream->runtime->private_data;

	u8 channel = voice->channel;
	u8 command;

	switch (cmd) {
	case SNDRV_PCM_TRIGGER_START:
		set_bit(SAM_VOICE_PLAYING, voice-status);
		command = SAM_W_START;
		break;
	case SNDRV_PCM_TRIGGER_STOP:
		command = SAM_W_CLOSE;
		break;
	default:
		return -EINVAL;
	}

	/* HACK: sam9407 has no STOP trigger command. We send SAM_W_CLOSE
	   and wait for voice close ACK in irq handler */
	snd_sam9407_command(NULL, command,
			&channel, 1, NULL, 0, -1);
	return 0;
}

static snd_pcm_uframes_t snd_sam9407_pointer(snd_pcm_substream_t * substream)
{
	snd_sam9407_voice_t *voice = (snd_sam9407_voice_t *) substream->runtime->private_data;

	return voice->hwptr;
}


