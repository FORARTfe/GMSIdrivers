static int snd_sam9407_channel_alloc(sam9407_t *sam)
{
	int idx;

	if (sam->voice_cnt >= SAM_MAX_PCM_CHANNELS)
		return -1;
	for (idx = SAM_MAX_PCM_CHANNELS-1; idx >= 0; idx--) {
		if (!(sam->voice_map & (1 << idx))) {
			sam->voice_map |= 1 << idx;
			sam->voice_cnt++;
			return idx;
		}
	}
	return -1;
}

static void snd_sam9407_channel_free(sam9407_t *sam, int voice)
{
	if (sam->voice_map & (1 << voice)) {
		sam->voice_map &= ~(1 << voice);
		sam->voice_cnt--;
	}
}

snd_sam_voice_t *snd_sam9407_voice_alloc(sam9407_t * sam)
{
	snd_sam_voice_t *voice;
	int idx;

	idx = snd_sam_channel_alloc(sam);
	if(idx < 0)
		return NULL;

	voice = &sam->voices[idx];
	clear_bit(SAM_VOICE_PLAYING, voice->status);
	set_bit(SAM_VOICE_IN_USE, voice->status);
	voice->pcm = 1;
	voice->hwptr = 0;

	return voice;
}

void snd_sam9407_voice_free(sam9407_t * sam, snd_sam_voice_t *voice)
{
	if (voice == NULL)
		return;

	voice->pcm = 0;
	clear_bit(SAM_VOICE_IN_USE, voice->status);
	snd_sam9407_channel_free(sam, voice->number);
}

static int snd_sam9407_playback_open(snd_pcm_substream_t * substream)
{
	sam9407_t *sam = snd_pcm_substream_chip(substream);
	snd_pcm_runtime_t *runtime = substream->runtime;
	snd_sam9407_voice_t *voice;

	unsigned long flags;

	spin_lock_irqsave(&sam->voice_lock, flags);

	/* disable config controls */
	if(sam->voice_cnt == 0)
		snd_sam9407_disable_config_ctl(sam);

	voice = snd_sam_voice_alloc(sam);
	if (voice == NULL) {
		spin_unlock_irqrestore(&sam->voice_lock, flags);
		return -EAGAIN;
	}
	spin_unlock_irqrestore(&sam->voice_lock, flags);

	snd_sam_pcm_mixer_build(sam, voice, substream);
	voice->substream = substream;
	runtime->private_data = voice;
	runtime->hw = snd_sam9407_playback;

#if 0
	/* FIXME: check this */
	snd_pcm_set_sync(substream);
	snd_pcm_hw_constraint_minmax(runtime, SNDRV_PCM_HW_PARAM_BUFFER_SIZE, 0, 64*1024);
#endif

	return 0;
}

static int snd_sam9407_playback_close(snd_pcm_substream_t * substream)
{
	sam9407_t *sam = snd_pcm_substream_chip(substream);
	snd_pcm_runtime_t *runtime = substream->runtime;
	snd_sam_voice_t *voice = (snd_trident_voice_t *) runtime->private_data;

	unsigned long flags;

	/* release PCM mixer element */
	snd_sam9407_pcm_mixer_free(sam, voice, substream);

	spin_lock_irqsave(&sam->voice_lock, flags);
	snd_sam_voice_free(sam, voice);

	/* enable config controls */
	if(sam->voice_cnt == 0)
		snd_sam9407_enable_config_ctl(sam);

	spin_unlock_irqrestore(&sam->voice_lock, flags);

	return 0;
}

