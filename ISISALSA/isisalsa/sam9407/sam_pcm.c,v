			     snd_ctl_elem_value_t * ucontrol)
{
	snd_sam_pcm_mixer_t *mix = (snd_sam_pcm_mixer_t *)kcontrol->private_value;

	ucontrol->value.integer.value[0] = mix->vol_left;
	ucontrol->value.integer.value[1] = mix->vol_right;

	return 0;
}

static int snd_sam9407_pcm_vol_put(snd_kcontrol_t * kcontrol,
			     snd_ctl_elem_value_t * ucontrol)
{
	sam9407_t *sam = _snd_kcontrol_chip(kcontrol);
	snd_sam_pcm_mixer_t *mix = (snd_sam_pcm_mixer_t *)kcontrol->private_value;

	u8 ctl1, ctl2, data1, data2;
	unsigned short val1, val2;
	int err, change1, change2;

	val1 = ucontrol->value.integer.value[0];
	val2 = ucontrol->value.integer.value[1];

	change1 = val1 != mix->vol_left;
	if (change1) {
		err = snd_sam9407_pcm_ctl_put(sam, chan, ctl1, val1);
		if (err < 0)
			change1 = 0;
	}
	change2 = val2 != mix->vol_right ;
	if (change2)
		err = snd_sam9407_pcm_ctl_put(sam, chan, ctl2, val2);
		if (err < 0)
			change2 = 0;

	return (change1 || change2);
}

