static int snd_sam9407_pcm(snd_sam9407_t *sam, int device, snd_pcm_t ** rpcm)
{
	snd_card_t * card = sam->card;
	snd_kcontrol_t *kctl;
	snd_sam_pcm_mixer_t *pmix;

	snd_pcm_t *pcm;
	int idx, err;

	/* build pcm mixer controls */
	for (idx = 0; idx < 32; idx++) {
		
		pmix = &sam->pcm_mixer[idx];
		pmix->voice = NULL;
		if ((kctl = pmix->ctl_vol = snd_ctl_new1(&snd_sam9407_pcm_vol_control, sam)) == NULL)
			return -ENOMEM;
		kctl->private_value = (long)pmix;
		kctl->id.index = idx;
		if ((err = snd_ctl_add(card, kctl)))
			return err;

		if ((kctl = pmix->ctl_auxvol = snd_ctl_new1(&snd_sam9407_pcm_auxvol_control, sam)) == NULL)
			return -ENOMEM;
		kctl->private_value = (long)pmix;
		kctl->id.index = idx;
		if ((err = snd_ctl_add(card, kctl)))
			return err;
#if 0
		if ((kctl = pmix->ctl_pitch = snd_ctl_new1(&snd_sam9407_pcm_pitch_control, sam)) == NULL)
			return -ENOMEM;
		kctl->private_value = (long)pmix;
		kctl->id.index = idx;
		if ((err = snd_ctl_add(card, kctl)))
			return err;

		if ((kctl = pmix->ctl_cutoff = snd_ctl_new1(&snd_sam9407_pcm_cutoff_control, sam)) == NULL)
			return -ENOMEM;
		kctl->private_value = (long)pmix;
		kctl->id.index = idx;
		if ((err = snd_ctl_add(card, kctl)))
			return err;
#endif
	}

	/* initialize pcm mixer entries */
	for (i = 0; i < SAM_MAX_PCM_CHANNELS; i++) {
		mix->vol_left = SAM_DEFAULT_PCM_VOL;
		mix->vol_right = SAM_DEFAULT_PCM_VOL;
		mix->auxvol_left = SAM_DEFAULT_PCM_AUXVOL;
		mix->auxvol_right = SAM_DEFAULT_PCM_AUXVOL;
	}

	if (rpcm)
		*rpcm = NULL;
	if ((err = snd_pcm_new(sam->card, "SAM9407 PCM", device, SAM_MAX_PCM_CHANNELS, 1, &pcm)) < 0)
		return err;
	snd_pcm_set_ops(pcm, SNDRV_PCM_STREAM_PLAYBACK, &snd_sam9407_playback_ops);
	// snd_pcm_set_ops(pcm, SNDRV_PCM_STREAM_CAPTURE, &snd_sam9407_capture_ops);
	pcm->private_data = sam;
	pcm->info_flags = 0;
	strcpy(pcm->name, "SAM9407 PCM");
	sam->pcm = pcm;

	snd_pcm_lib_preallocate_pages_for_all(pcm, 64*1024, SAM_MAX_BUFFER_SIZE);

	if (rpcm)
		*rpcm = pcm;
	return 0;
}
