/*
 *  send control data to SAM9407
 *  and update control table
 * -> ctl_table_rwlock should be writelocked
 */
static int snd_sam9407_pcm_ctl_put(sam9407_t * sam, int chan, u8 ctl, u16 val)
{
	u8 data[3];
	int err;

	data[0] = chan;
	data[1] = val;
	data[2] = val >> 8;
	
	err = snd_sam9407_command(NULL, ctl, &data, 3, NULL, 0, -1);
	if (err < 0) {
		snd_printd("sam9407: change PCM control failed, ctl = 0x%x\n", ctl);
		return -EIO;
	}
	return 0;
}

