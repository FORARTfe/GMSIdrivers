#define __NO_VERSION__
#include <sound/driver.h>
#include <asm/io.h>
#include <sound/core.h>
#include <sam9407.h>

/* acknowledges */
#define SAM_ACK_CTL		0x60
#define SAM_ACK_CFG		0x00


/*
 * get byte from control table
 */
int snd_sam9407_ctl_table_get(sam9407_t * sam, u8 ctl, u8 * data)
{
	int idx = ctl >> 1;

	if (idx >= SAM_CTL_TABLE_SIZE)
		return -EINVAL;

	if (ctl & 0x01)
		*data = sam->ctl_table[idx] >> 8;
	else
		*data = sam->ctl_table[idx];
	return 0;
}

/*
 *  send control data to SAM9407
 *  and update control table
 */
int snd_sam9407_ctl_put(sam9407_t * sam, u8 ctl, u8 data)
{
	u8 confirm;
	int idx, err;

	idx = ctl >> 1;

	if (idx >= SAM_CTL_TABLE_SIZE)
		return -EINVAL;

	/* Readback Table change notifications should be enabled! */
	err = snd_sam9407_command(sam->pcm_io_queue, ctl,
			      &data, 1, &confirm, 1, SAM_ACK_CTL);

	if ((err < 0) || (confirm != ctl)) {
		snd_printd ("sam9407: change control failed for ctl 0x%x\n", ctl);
		return -EINVAL;
	}

	/* update data table word */
	if (ctl & 0x01) {
		sam->ctl_table[idx] &= 0x00ff;
		sam->ctl_table[idx] |= data << 8;
	} else {
		sam->ctl_table[idx] &= 0xff00;
		sam->ctl_table[idx] |= data;
	}

	return 0;
}

/*
 * send config data to SAM9407
 * and update control table 
 */
int snd_sam9407_cfg_put(sam9407_t * sam, u8 cfg, u8 data)
{
	int idx, err;

	idx = cfg >> 1;

	if (idx >= SAM_CTL_TABLE_SIZE)
		return -EINVAL;

	err = snd_sam9407_command(sam->system_io_queue, cfg,
				  &data, 1, NULL, 0, SAM_ACK_CFG);

	if (err < 0) {
		snd_printd("sam9407: change config failed for 0x%x\n", cfg);
		return -EINVAL;
	}

	/* update data table word */
	if (cfg & 0x01) {
		sam->ctl_table[idx] &= 0x00ff;
		sam->ctl_table[idx] |= data << 8;
	} else {
		sam->ctl_table[idx] &= 0xff00;
		sam->ctl_table[idx] |= data;
	}

	return 0;
}
