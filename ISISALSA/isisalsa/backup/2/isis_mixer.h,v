static int isis_studio_playback_get(snd_kcontrol_t *kcontrol,
                           snd_ctl_elem_value_t *ucontrol)
{
		isis_t *isis = snd_kcontrol_chip(kcontrol);
		u8 ch_dest=(kcontrol->private_value & 0x30)>>4;

		if(kcontrol->private_value & 0x08) { // it's the mute control
			ucontrol->value.integer.value[0] = (isis->playback_volume[1+2*ch_dest] & 0x80) >> 7;
			ucontrol->value.integer.value[1] = (isis->playback_volume[2+2*ch_dest] & 0x80) >> 7;
		}
		else { // it's the volume control
			ucontrol->value.integer.value[0] = (isis->playback_volume[1+2*ch_dest] & 0x7F);
			ucontrol->value.integer.value[1] = (isis->playback_volume[2+2*ch_dest] & 0x7F);
		}
        return 0;
}



static int isis_studio_playback_put(snd_kcontrol_t *kcontrol,
                           snd_ctl_elem_value_t *ucontrol)
{
		isis_t *isis = snd_kcontrol_chip(kcontrol);
		/* private_value = (dest << 4) | (mute << 3) | (0) */
		/* ch_dest = 0 if destination is CH1&2
		 * ch_dest = 1 if destination is CH3&4
		 * so 1+2*ch_dest gives correct 'left channel' index to table.
		 * so 2+2*ch_dest gives correct 'right channel' index to table.
		 * the table values are: playback_volume[dest]=(mute_state << 7) | (volume & 0x7F)
		 */
		u8 ch_dest=(kcontrol->private_value & 0x30)>>4;

		if(kcontrol->private_value & 0x08) { // it's the mute control
			isis->playback_volume[1+2*ch_dest]=(ucontrol->value.integer.value[0] << 7) | (isis->playback_volume[1+2*ch_dest] & 0x7f);
			isis->playback_volume[2+2*ch_dest]=(ucontrol->value.integer.value[1] << 7) | (isis->playback_volume[2+2*ch_dest] & 0x7f);
		}
		else { // it's the volume control
			isis->playback_volume[1+2*ch_dest]=(ucontrol->value.integer.value[0]) | (isis->playback_volume[1+2*ch_dest] & 0x80);
			isis->playback_volume[2+2*ch_dest]=(ucontrol->value.integer.value[1]) | (isis->playback_volume[2+2*ch_dest] & 0x80);
		}
		/* This is the 'one-call-does-it-all' approach
		* the isis playback volume commands are:
		* 0x34 for ch1/2, 0x35 for ch3/4 so 0x34+ch_dest is ok
		* The multiplication is to account for the MUTED state
		* You can change volume but muted = no volume
		*/
	snd_printk(" Table values (playback): %02X, %02X to \n",isis->playback_volume[1+2*ch_dest],isis->playback_volume[2+2*ch_dest]);

		isis_set_volume(isis,(0x45+ch_dest),0,
				(isis->playback_volume[1+2*ch_dest] & 0x7F) * ((isis->playback_volume[1+2*ch_dest] & 0x80)>> 7),
				(isis->playback_volume[2+2*ch_dest] & 0x7F) * ((isis->playback_volume[2+2*ch_dest] & 0x80) >> 7));
        return 1; // always changed (is this allowed?)

}

static int isis_studio_playback_info(snd_kcontrol_t *kcontrol,
                          snd_ctl_elem_info_t *uinfo)
{
   		isis_t *isis = snd_kcontrol_chip(kcontrol);
        u8 ch_src=kcontrol->private_value & 0x07;
		u8 ch_dest=(kcontrol->private_value & 0x30)>>4;

		if(kcontrol->private_value & 0x08) { // it's the mute control
			uinfo->type = SNDRV_CTL_ELEM_TYPE_BOOLEAN;
			uinfo->count = 2;
			uinfo->value.integer.min = 0;
			uinfo->value.integer.max = 1;
		}
		else {
			uinfo->type = SNDRV_CTL_ELEM_TYPE_INTEGER;
			uinfo->count = 2;
			uinfo->value.integer.min = 0;
			uinfo->value.integer.max = 0x7F;
		}
        return 0;
}
#define ISIS_PLAYBACK_VOLUME(xname, dest) \
{ .iface = SNDRV_CTL_ELEM_IFACE_MIXER, .name = (xname), .info = isis_studio_playback_info, \
  .get = isis_studio_playback_get, .put = isis_studio_playback_put, \
  .private_value = (dest << 4) | (0 << 3) }

#define ISIS_PLAYBACK_MUTE(xname, dest) \
{ .iface = SNDRV_CTL_ELEM_IFACE_MIXER, .name = (xname), .info = isis_studio_playback_info, \
  .get = isis_studio_playback_get, .put = isis_studio_playback_put, \
