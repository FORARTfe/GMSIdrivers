 */
int snd_isis_sam9707_rack_info(struct snd_kcontrol *kcontrol,
									struct snd_ctl_elem_info *uinfo) {

	uinfo->type = SNDRV_CTL_ELEM_TYPE_INTEGER;
	uinfo->count = 2;
	uinfo->value.integer.min = 0;
	uinfo->value.integer.max = 0xff;
	return 0;
