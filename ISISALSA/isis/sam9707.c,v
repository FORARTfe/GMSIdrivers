	loop = SAM_READ_LOOP_COUNTER;	
	while(((snd_isis_read(chip, SAM9707_STATUS) & ( 1 << 7)) == 0x00) & --loop) 
	{
		snd_printk("read data8 : %2x\n",snd_isis_read(chip, SAM9707_DATA8));
	}
	
