/*
 * 		Read a byte register on SAM 9707
 * 
 *    First index the register reg with maestro IDMA_ADRESS register
 *    then read is value in maestro IDMA_DATA register
 * 
 */

 u8 __isis_read(struct isis_sam9707_chip *chip, u16 reg) {
	int value;
	
	outw(reg, chip->io_port + ISIS_ADDRESS);
	value = inw(chip->io_port + ISIS_DATA) & 0xff;
	return value;
}

 u8 snd_isis_read(struct isis_sam9707_chip *chip, u16 reg) {
	unsigned long flags;
	u8 data;
	
	spin_lock_irqsave(&chip->reg_lock, flags);
	data =  __isis_read(chip, reg);
	spin_unlock_irqrestore(&chip->reg_lock, flags);
	return data;
}


 u8 __isis_read_status(struct isis_sam9707_chip *chip) {
	int value;
	
	value = __isis_read(chip, SAM9707_STATUS);
	return value;
}


 u8 snd_isis_read_status(struct isis_sam9707_chip *chip) {
	unsigned long flags;
	u8 data;
	
	spin_lock_irqsave(&chip->reg_lock, flags);
	data =  __isis_read_status(chip);
	spin_unlock_irqrestore(&chip->reg_lock, flags);
	return data;
}

 u8 __isis_read_data8(struct isis_sam9707_chip *chip) {
	int value;
	int loop =SAM_READ_LOOP_COUNTER;
	 
	while(--loop & (__isis_read_status(chip) & (0x80)));
	value = __isis_read(chip, SAM9707_DATA8);
	return value;
}


 u8 snd_isis_read_data8(struct isis_sam9707_chip *chip) {
	unsigned long flags;
	u8 data;
	
	spin_lock_irqsave(&chip->reg_lock, flags);
	data =  __isis_read_data8(chip);
	spin_unlock_irqrestore(&chip->reg_lock, flags);
	return data;
}

/* from old stuff to test */
static inline int isis_dream_outb(struct isis_sam9707_chip *chip,u16 reg,int value)
{
        int count=0;
        int status;

        do
        {
                outw(1,chip->io_port + 0x44); /* select status register */
                status = inw(chip->io_port + 0x46) & 0xff;
                outw(2,chip->io_port + 0x44); /* select back data16 register */
        }
        while((count++ < 0x6000) && ((status & 0x40) != 0));
        printk("isis.o: outb = status %x, count %d\n", status, count);
        /*              SAM READY */
        if(count<= 0x6000)
        {
                outw(reg & 0xff, chip->io_port + 0x44);
                outw(value & 0xff, chip->io_port + 0x46);
                outw(2, chip->io_port + 0x44);
                return 0;
        }
        else
                return -EIO;

}


/*
 * 		Write a byte register on SAM 9707
 * 
 *    First index the status register with maestro IDMA_ADRESS register
 *    then wait for status indicate sam is ready 
 * 	  then index teh reg register and last 
 *    Write data value in maestro IDMA_DATA register
 * 
 */

 void __isis_write(struct isis_sam9707_chip *chip, u16 reg, u8 data) {
	int tmploop= SAM_READ_LOOP_COUNTER;
	int tmp;
	
	outw(SAM9707_STATUS, chip->io_port + ISIS_ADDRESS);
	while(tmploop-- && (
		((tmp = inw(chip->io_port+ISIS_DATA)) &  0x40)!=0x40));
	outw(reg, chip->io_port + ISIS_ADDRESS);
	outw(data & 0xff, chip->io_port + ISIS_DATA);
}


 void isis_write(struct isis_sam9707_chip *chip, u16 reg, u8 data) {
	unsigned long flags;
	
	spin_lock_irqsave(&chip->reg_lock, flags);
	__isis_write(chip, reg, data);
	spin_unlock_irqrestore(&chip->reg_lock, flags);
}

/*
 * 		Read a word register on SAM 9707
 * 
 *    First index the register reg with maestro IDMA_ADRESS register
 *    then read is value in maestro IDMA_DATA register
 * 
 */

 u16 __isis_read16(struct isis_sam9707_chip *chip, u16 reg) {
	u16 value;
	
	outw(SAM9707_DATA16, chip->io_port +ISIS_ADDRESS);
	value = inw( chip->io_port + ISIS_DATA);
	return value;
}

 u16 isis_read16(struct isis_sam9707_chip *chip, u16 reg) {
	unsigned long flags;
	u16 data;
	
	spin_lock_irqsave(&chip->reg_lock, flags);
	data = __isis_read16(chip, reg);
	spin_unlock_irqrestore(&chip->reg_lock, flags);
	return data;
}

/*
 * 		Write a word register on SAM 9707
 * 
 *    First index the status register with maestro IDMA_ADRESS register
 *    then wait for status indicate sam is ready 
 * 	  then index teh reg register and last 
 *    Write data value in maestro IDMA_DATA register
 * 
 */

 void __isis_write16(struct isis_sam9707_chip *chip, u16 data) {
	int tmploop= SAM_READ_LOOP_COUNTER;
	
	while(tmploop-- && (__isis_read_status(chip) &  0x40));
	outw(SAM9707_DATA16, chip->io_port +ISIS_ADDRESS);
	outw(data, chip->io_port + ISIS_DATA);
}

 void isis_write16(struct isis_sam9707_chip *chip, u16 reg, u16 data) {
	unsigned long flags;
	
	spin_lock_irqsave(&chip->reg_lock, flags);
	__isis_write16(chip,  data);
	spin_unlock_irqrestore(&chip->reg_lock, flags);
}
/*
 * 
 * 	Burst write to data16 register
 * 
 * Write nbw word (u16) value contained in w to the data16 register.
 * 
 */
 void __isis_burst_write(struct isis_sam9707_chip *chip,u16 *w, int nbw) {
	int tmploop= SAM_READ_LOOP_COUNTER;
	
	while(tmploop-- && (__isis_read_status(chip) &  0x40));
	outw(SAM9707_DATA16, chip->io_port +ISIS_ADDRESS);	
	while(nbw--) outw(*w++, chip->io_port + ISIS_DATA);
}

 void isis_burst_write(struct isis_sam9707_chip *chip,u16 *w, int nbw) {
	unsigned long flags;
	
	spin_lock_irqsave(&chip->reg_lock, flags);
	__isis_burst_write(chip,w, nbw);
	spin_unlock_irqrestore(&chip->reg_lock, flags);
}





