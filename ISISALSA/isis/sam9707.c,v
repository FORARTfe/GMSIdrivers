int snd_isis_sam9707_rack_get(struct snd_kcontrol*kcontrol,
								struct snd_ctl_elem_value *ucontrol) {
	/* TODO :
	 * 		Read and return volume value for selected playback channel
	 */
	int vol;
	 
 	vol=(int) kcontrol->private_value;
	ucontrol->value.integer.value[0] = vol & 0xff;
	ucontrol->value.integer.value[1] = (vol >> 8) & 0xff;
	return 0;
}

int snd_isis_sam9707_rack_put(struct snd_kcontrol*kcontrol,
										struct snd_ctl_elem_value *ucontrol) {
	/* TODO :
	 * 		Set volume value for selected playback channel
	 */	 
	int vol;
	 
	vol = ucontrol->value.integer.value[0] & 0xff;
	vol = (ucontrol->value.integer.value[1] & 0xff) << 8;
	kcontrol->private_value = vol;
	return 0;
};



