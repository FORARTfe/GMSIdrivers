int snd_isis_pcm_trigger(struct snd_pcm_substream *substream, int cmd)
{
	struct isis_sam9707_chip *chip = snd_pcm_substream_chip(substream);
	
	snd_printk("snd_isis_pcm_trigger : %x\n", cmd);
	switch (cmd)
	{
		case SNDRV_PCM_TRIGGER_START:
			snd_isis_write_control(chip, SAM_W_START);
			snd_isis_write_data8(chip, substream->number);		
			break;
		case SNDRV_PCM_TRIGGER_STOP:
			snd_isis_write_control(chip, SAM_W_CLOSE);
			snd_isis_write_data8(chip, substream->number);
			break;
		default:
			return -EINVAL;
	}
	return 0;
};

