#define SAM_WAVE_POST		0x63
#define	SAM_MOD_POST		0x64
#define SAM_AUDECH_POST		0x65
#define SAM_EFF_POST		0x66
#define SAM_ECH_ONOFF		0x68
#define SAM_REV_TYPE		0x69
#define	SAM_CHR_TYPE		0x6a
#define SAM_EQU_TYPE		0x6b
