#define SAM_GMREV_SEND		0x25
#define SAM_GMCHR_SEND		0x26
#define SAM_AUDREV_SEND		0x27
#define SAM_ECH_LEV			0x28
#define SAM_ECH_TIM			0x29
#define SAM_ECH_FEED		0x2a
#define SAM_UNK_3			0x2c
#define SAM_SUR_VOL			0x30
#define SAM_SUR_DEL			0x31
#define SAM_SUR_INP			0x32
#define SAM_SUR_24			0x33
#define SAM_AUDL_VOL		0x34
#define SAM_AUDR_VOL		0x35
#define SAM_AUDL_PAN		0x36
#define SAM_AUDR_PAN		0x37
#define SAM_GM_VOL			0x38
#define SAM_GM_PAN			0x39
#define SAM_REV_VOL			0x3a
#define SAM_CHR_VOL			0x3b
#define SAM_EN_MIDOUT		0x3d
#define SAM_CMD_UART_MOD	0x3f /* Switch to UART mode */
#define SAM_W_OPEN			0x40
#define SAM_W_CLOSE			0x41
#define SAM_W_START			0x42
#define SAM_END_XFER		0x43/* Sent to sam9707 after end of transfer */
#define SAM_W_PITCH			0x44 /* Change the pitch of the wave during playback */
#define SAM_W_VOLLEFT		0x45	/* Change the current left volume */
#define SAM_W_VOLRIGHT		0x46	/* Change the current right volume */
#define SAM_W_VOLAUXLEFT	0x47 	/* Change the left auxiliary level */
#define SAM_CMD_GEN_INT		0x48	/* Generate an interrupt */
#define SAM_W_VOLAUXRIGHT	0x49	/* Change the right auxiliary level */
#define SAM_W_FILT_FC		0x4a	/* Change filter cutoff frequency */
#define SAM_W_FILT_Q		0x4b	/* Change filter resonance */
#define SAM_GET_VOI			0x51
#define SAM_VOI_OPEN		0x52
#define SAM_VOI_CLOSE		0x53
