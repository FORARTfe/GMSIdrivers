@#ifndef __SAM9707_H
#define __SAM9707_H




/* ------------------- DEFINES -------------------- */

#define ISIS_DATA     0x46
#define ISIS_ADDRESS  0x44


#define SAM9707_DATA8	0
#define SAM9707_STATUS	1
#define SAM9707_CONTROL	1
#define SAM9707_DATA16	2

/* Memory mapping table IDs */
#define SAM_MMT_ID_MASK				0xF7F
#define SAM_MMT_ID_MEMSIZE			0x00
