	snd_isis_write_data8(chip, 0);

	snd_printk("unluting channlels\n");
	outw(0x07ff,chip->parent->io_port + 0x64); // set GPIO mask
	tmp = inw(chip->parent->io_port + 0x60 ); //read the GPIO
	tmp |= 0x0800;
	outw(tmp, chip->parent->io_port + 0x60); // write new valueto GPIO	
	
	return 0;
}

