static void snd_sam_pcm_ctl_put(struct isis_sam9707_chip *sam, int chan, u8 ctl, u16 val){
	int err;

	while((snd_isis_read_status(sam)  & 0x80));
	snd_isis_write_control(sam,ctl);
	snd_isis_write_data8(sam, chan);
	snd_isis_write_data8(sam, val & 0xFF);
	snd_isis_write_data8(sam, (val << 8));
};
 
