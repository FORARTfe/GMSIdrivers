/*
 * 
 * 			Detect and init the card
 * 
 */
int snd_isis_setup_card(struct isis_sam9707_chip *chip) {
	unsigned short w;
	int loop;
	u16 value,tmp;

	/*
	 * Disabling SAM interrupts 
	 */
	tmp = inw(chip->parent->io_port + 0x18) & ~SAM_INTERRUPT;
	outw(tmp , chip->parent->io_port + + 0x18);
	/*
	*	Enabling MPU-401
	*/
	pci_read_config_word(chip->parent->pci, 0x50, &w);
	w |= 0x18;
	pci_write_config_word(chip->parent->pci, 0x50, w);
	snd_printk("MPU 401 Enabled\n");
	/*
	 * 		Setting up clock source
	 */
	outw(0x0193, chip->parent->io_port + 0x64); // set GPIO mask
	outw(0x0e64, chip->parent->io_port + 0x68); // set GPIO dir
	value = inw(chip->parent->io_port + 0x60); //read the GPIO
	value &= 0xff9f;
	value |= 0x0024;
	outw(value, chip->parent->io_port + 0x60); // write new value to GPIO
	snd_printk("Clock source set\n");
	/*
	 * 	Setting Mistrerious PLD
	 */
 	outw(0x0dff,chip->parent->io_port + 0x64); // set GPIO mask
	value = inw(chip->parent->io_port + 0x60 ); //read the GPIO
	value |= 0x0200;
	outw(value, chip->parent->io_port + 0x60); // write new valueto GPIO
	snd_printk("PLD set\n");
	/*
	 * 	Reset GPIO Mask
	 */
 	outw(0x0fff, chip->parent->io_port + 0x64); // set GPIO mask

	return 0;
};


