static  int snd_isis_firm_open (snd_info_entry_t *entry,  unsigned short mode, 
		void **file_private_data)
{
	struct isis_sam9707_chip *chip;
	
	/*	FIXME
	 * 	Need to debug init code to get rid of maxiinit
	 *  for now code is blocked at open time
	 */
	snd_printk("Opening Firmware\n");
	chip = (struct isis_sam9707_chip *) entry->private_data;
	if(!chip) 
	{
		snd_printk("chip is %p\n", chip);
		return -ENODEV;
	} 
	
	if(chip->firm != 1) 
		return -EBUSY;
		
	if(!(chip->firmptr = (u8 *) kmalloc(ISIS_FIRM_SIZE, GFP_KERNEL))) {
		snd_printk("Can't allocate memory for firmware\n");
		return -ENOMEM;		/*	Memory full */
	}
	
	return 0;
}
static long snd_isis_firm_write(snd_info_entry_t *entry, 
							void * file_private_data, struct file * file, 
							const char *buf, unsigned long count,
							unsigned long pos) {
	struct isis_sam9707_chip *chip;
	
	snd_printk("Downloading Firmware \n");
	/*		Downlaod the firm */
	chip = (struct isis_sam9707_chip *) entry->private_data;
	if(!chip) 
	{
		snd_printk("chip is %p\n", chip);
		return -ENODEV;
	}
	snd_printk("Chip is %p \n", chip);
	snd_printk("pos= %ld\n", chip->firmpos);
/* should Never happen but better safe than sorry */	
	if(chip->firm  != 1) return -ENODEV; 
	copy_from_user(chip->firmptr + chip->firmpos,buf,count);
	chip->firmpos += count;
	snd_printk("Firmware Downloaded %ld\n", chip->firmpos);
	return count;
}
