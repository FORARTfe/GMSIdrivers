		switch(status & SAM_STATUS_ID_MASK) {
			case SAM_STATUS_ID_MIDI:
				break;
			case SAM_STATUS_ID_STREAM:
				channel = snd_isis_read_data8(chip);
				// TODO: get the pending data from the pcm stream and burstwrite them				
				break;			
			case SAM_STATUS_ID_MOD:
				break;			
			case SAM_STATUS_ID_GENERAL:
				break;
		}
		
}


