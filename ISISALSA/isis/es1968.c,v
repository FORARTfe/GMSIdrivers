/*
 * 		Read a byte register on SAM 9707
 * 
 *    First index the register reg with maestro IDMA_ADRESS register
 *    then read is value in maestro IDMA_DATA register
 * 
 */

static u8 __isis_read(isis_sam9707_chip_t *chip, u16 reg) {
	int value;
	
	outw(reg, chip->parent->io_port + ISIS_ADDRESS);
	value = inw(chip->parent->io_port + ISIS_DATA) & 0xff;
	return value;
}

static u8 snd_isis_read(isis_sam9707_chip_t *chip, u16 reg) {
	unsigned long flags;
	u8 data;
	
	spin_lock_irqsave(&chip->reg_lock, flags);
	data =  __isis_read(chip, reg);
	spin_unlock_irqrestore(&chip->reg_lock, flags);
	return data;
}


static u8 __isis_read_status(isis_sam9707_chip_t *chip) {
	int value;
	
	value = __isis_read(chip, SAM9707_STATUS);
	return value;
}


static u8 snd_isis_read_status(isis_sam9707_chip_t *chip) {
	unsigned long flags;
	u8 data;
	
	spin_lock_irqsave(&chip->reg_lock, flags);
	data =  __isis_read_status(chip);
	spin_unlock_irqrestore(&chip->reg_lock, flags);
	return data;
}

static u8 __isis_read_data8(isis_sam9707_chip_t *chip) {
	int value;
	int loop =SAM_READ_LOOP_COUNTER;
	 
	while(--loop & (__isis_read_status(chip) & (0x80)));
	value = __isis_read(chip, SAM9707_DATA8);
	return value;
}


static u8 snd_isis_read_data8(isis_sam9707_chip_t *chip) {
	unsigned long flags;
	u8 data;
	
	spin_lock_irqsave(&chip->reg_lock, flags);
	data =  __isis_read_data8(chip);
	spin_unlock_irqrestore(&chip->reg_lock, flags);
	return data;
}

/*
 * 		Write a byte register on SAM 9707
 * 
 *    First index the status register with maestro IDMA_ADRESS register
 *    then wait for status indicate sam is ready 
 * 	  then index teh reg register and last 
 *    Write data value in maestro IDMA_DATA register
 * 
 */

static void __isis_write(isis_sam9707_chip_t *chip, u16 reg, u8 data) {
	int tmploop= SAM_READ_LOOP_COUNTER;
	int tmp;
	
	outw(SAM9707_STATUS, chip->parent->io_port + ISIS_ADDRESS);
	while(tmploop-- && (
		(tmp = inw(chip->parent->io_port+ISIS_DATA)) &  0x40));
	outw(reg, chip->parent->io_port + ISIS_ADDRESS);
	outw(data & 0xff, chip->parent->io_port + ISIS_DATA);
}


static void isis_write(isis_sam9707_chip_t *chip, u16 reg, u8 data) {
	unsigned long flags;
	
	spin_lock_irqsave(&chip->reg_lock, flags);
	__isis_write(chip, reg, data);
	spin_unlock_irqrestore(&chip->reg_lock, flags);
}
#define snd_isis_write_data8(chip, data) isis_write(chip, SAM9707_DATA8, data)
#define snd_isis_write_control(chip, data) isis_write(chip, SAM9707_CONTROL, data)


/*
 * 		Read a word register on SAM 9707
 * 
 *    First index the register reg with maestro IDMA_ADRESS register
 *    then read is value in maestro IDMA_DATA register
 * 
 */

static u16 __isis_read16(isis_sam9707_chip_t *chip, u16 reg) {
	u16 value;
	
	outw(SAM9707_DATA16, chip->parent->io_port +ISIS_ADDRESS);
	value = inw( chip->parent->io_port + ISIS_DATA);
	return value;
}

static u16 isis_read16(isis_sam9707_chip_t *chip, u16 reg) {
	unsigned long flags;
	u16 data;
	
	spin_lock_irqsave(&chip->reg_lock, flags);
	data = __isis_read16(chip, reg);
	spin_unlock_irqrestore(&chip->reg_lock, flags);
	return data;
}

/*
 * 		Write a word register on SAM 9707
 * 
 *    First index the status register with maestro IDMA_ADRESS register
 *    then wait for status indicate sam is ready 
 * 	  then index teh reg register and last 
 *    Write data value in maestro IDMA_DATA register
 * 
 */

static void __isis_write16(isis_sam9707_chip_t *chip, u16 data) {
	int tmploop= SAM_READ_LOOP_COUNTER;
	
	while(tmploop-- && (__isis_read_status(chip) &  0x40));
	outw(SAM9707_DATA16, chip->parent->io_port +ISIS_ADDRESS);
	outw(data, chip->parent->io_port + ISIS_DATA);
}

static void isis_write16(isis_sam9707_chip_t *chip, u16 reg, u16 data) {
	unsigned long flags;
	
	spin_lock_irqsave(&chip->reg_lock, flags);
	__isis_write16(chip,  data);
	spin_unlock_irqrestore(&chip->reg_lock, flags);
}
/*
 * 
 * 	Burst write to data16 register
 * 
 * Write nbw word (u16) value contained in w to the data16 register.
 * 
 */
static void __isis_burst_write(isis_sam9707_chip_t *chip,u16 *w, int nbw) {
	int tmploop= SAM_READ_LOOP_COUNTER;
	
	while(tmploop-- && (__isis_read_status(chip) &  0x40));
	outw(SAM9707_DATA16, chip->parent->io_port +ISIS_ADDRESS);	
	while(nbw--) outw(*w++, chip->parent->io_port + ISIS_DATA);
}

static void isis_burst_write(isis_sam9707_chip_t *chip,u16 *w, int nbw) {
	unsigned long flags;
	
	spin_lock_irqsave(&chip->reg_lock, flags);
	__isis_burst_write(chip,w, nbw);
	spin_unlock_irqrestore(&chip->reg_lock, flags);
}

