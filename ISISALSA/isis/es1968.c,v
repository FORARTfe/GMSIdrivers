 static int __devinit snd_isis_new_pcm(struct isis_sam9707_chip *chip) {
 	snd_pcm_t *pcmo;
 	snd_pcm_t *pcmi;
 	int err;
 	int i; /* loop counter */
// 	if(chip->firm < 2) return -ENODEV;
	for(i=0;i<2;i++) {
	 	if((err = snd_pcm_new(chip->parent->card, "ISIS SAM IN", i+1, 
	 			1, 0, &pcmi)) < 0)
 			return err;
		pcmi->private_data = (struct isis_sam9707 *) chip;
		strcpy(pcmi->name, "External Rack");
		chip->pcmi = pcmi;
		chip->ovoices = 0;
		snd_pcm_set_ops(pcmi, SNDRV_PCM_STREAM_PLAYBACK,
			&snd_isis_sam9707_pcm_play_ops);
		snd_printk("Creating Playback controls\n");

		snd_isis_sam9707_ctl_vol[i].private_value = &(chip->play_voice[i]);
		if((err = snd_ctl_add(chip->card, 
				snd_ctl_new1(&snd_isis_sam9707_ctl_vol[i], chip)))<0) {
			return err;
		}
	}
	snd_printk("new pcm doing record stuff\n");
	for(i=0;i<4;i++) {
	 	if((err = snd_pcm_new(chip->parent->card, "ISIS SAM OUT", 4+i+1, 
	 			0, 1, &pcmo)) < 0)
 			return err;
		pcmo->private_data = (struct isis_sam9707 *) chip;
		strcpy(pcmo->name, "External Rack");
		chip->pcmo = pcmo;
		chip->ivoices = 0;
		snd_pcm_set_ops(pcmo, SNDRV_PCM_STREAM_CAPTURE,
			&snd_isis_sam9707_pcm_rec_ops);
		snd_printk("Creating Record controls\n");

		snd_isis_sam9707_rec_ctl_vol[i].private_value = &(chip->rec_voice[i]);
		if((err = snd_ctl_add(chip->card, 
				snd_ctl_new1(&snd_isis_sam9707_rec_ctl_vol[i], chip)))<0) {
			return err;
		}	
	}
	snd_printk("new pcm exit\n");
	return 0;
 };
 
