@#
#		Makefile for isis out of kernel compilation.
#
#		For 2.6 Only as alsa suported only in 2.6 tree
#

ifndef KERNELDIR
	KERNELDIR := /lib/modules/$(shell uname -r)/build
endif

PWD := $(shell pwd)
VERSIONFILE := $(KERNELDIR)/include/linux/version.h
VERSION := $(shell awk -F\" '/REL/ {print $$2}' $(VERSIONFILE))
INSTALLDIR := /lib/modules/$(VERSION)/kernel/sound/pci	

all: modules

modules: 
	$(MAKE) -C $(KERNELDIR) SUBDIRS=$(PWD) modules

snd-es1968-objs := es1968.o sam9707.o

obj-$(CONFIG_SND_ES1968) += snd-es1968.o

install: $(obj-m)
	install -d $(INSTALLDIR)
	install -c snd-es1968.ko $(INSTALLDIR)
	depmod -a

clean:
	rm -f *.ko *.mod.c *.o .*.flags

@


