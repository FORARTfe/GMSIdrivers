#include <kcmdlineargs.h>
#include <kaboutdata.h>
#include <klocale.h>

#include "maxicontrol.h"

static const char *description =
	I18N_NOOP("MaxiControl");
// INSERT A DESCRIPTION FOR YOUR APPLICATION HERE
	
	
static KCmdLineOptions options[] =
{
  { 0, 0, 0 }
  // INSERT YOUR COMMANDLINE OPTIONS HERE
};

int main(int argc, char *argv[])
{

  KAboutData aboutData( "maxicontrol", I18N_NOOP("MaxiControl"),
    VERSION, description, KAboutData::License_GPL,
    "(c) 2003, Pieter Palmers", 0, 0, "pieterpalmers@@users.sourceforge.net");
  aboutData.addAuthor("Pieter Palmers",0, "pieterpalmers@@users.sourceforge.net");
  KCmdLineArgs::init( argc, argv, &aboutData );
  KCmdLineArgs::addCmdLineOptions( options ); // Add our own options.

  KApplication a;
  MaxiControl *maxicontrol = new MaxiControl();
  a.setMainWidget(maxicontrol);
  maxicontrol->show();  

  
  return a.exec();
}
