#include "maxicontrol.h"
#include "maxicontroller.h"

MaxiControl::MaxiControl(QWidget *parent, const char *name ) : MainForm(parent,name) {
      ctrl=new MaxiController(this);
      ctrl->init();
}

MaxiControl::~MaxiControl(){
  if (ctrl) {
    delete ctrl;
  }
}

/** No descriptions */
void MaxiControl::enableInt(int state){
  if (state) {
    log("Interrupts turned on\n");
  } else {
    log("Interrupts turned off\n");
  }
    
}

/** No descriptions */
void MaxiControl::log(char * logstr) {
  if (logstr) {
    logBox->setText(QString(logstr) + logBox->text());
  }
}
